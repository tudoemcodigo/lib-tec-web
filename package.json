{
  "name": "lib-tec-web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Monorepo dos pacotes @tudoemcodigo/* de frontend (React + TypeScript) do ecossistema Tudo em Código.",
  "license": "Apache-2.0",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "^24.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "build": "npm run build --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:packages": "node scripts/check-packages.mjs",
    "test": "vitest run --coverage",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run check:packages && npm run build && npm test",
    "e2e": "npm run build && playwright test -c packages/theme/e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@tudoemcodigo/tooling": "*",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "ajv": "^8.17.1",
    "eslint": "^9.39.5",
    "jsdom": "^30.1.3",
    "msw": "^3.0.3",
    "openapi-fetch": "^0.17.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  }
}
