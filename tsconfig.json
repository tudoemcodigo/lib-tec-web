{
  "extends": "./packages/tooling/tsconfig/base.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "@tudoemcodigo/theme": ["./packages/theme/src/index.ts"],
      "@tudoemcodigo/ui": ["./packages/ui/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*",
    "packages/*/test/**/*.ts",
    "packages/*/test/**/*.tsx",
    "packages/*/e2e/**/*.ts"
  ],
  "exclude": ["packages/*/dist", "packages/*/test/fixtures"]
}
