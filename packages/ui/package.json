{
  "name": "@tudoemcodigo/ui",
  "version": "0.0.1",
  "description": "Componentes de interface padronizados dos frontends Tudo em Código: feedback (alerta, toast, erro, vazio, carregando), cabeçalho de página, controles e formulário.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tudoemcodigo/lib-tec-web.git",
    "directory": "packages/ui"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ui.css": "./dist/ui.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/copy-css.mjs"
  },
  "peerDependencies": {
    "@base-ui/react": "^1.9.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
